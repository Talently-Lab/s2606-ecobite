# Plantilla para el backend. 

# App en runtime. Supabase → Project Settings → Database → Connection string
# → Transaction pooler (puerto 6543). Si la URI no trae el parámetro, agregar ?pgbouncer=true
DATABASE_URL=

# Migraciones de Prisma. Misma pantalla, conexión directa o Session (puerto 5432).
DIRECT_URL=

# Solo si además usan el cliente @supabase/supabase-js. Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# No agregar SUPABASE_SERVICE_ROLE_KEY. No va al repo ni al frontend.
# Prisma no la necesita para conectarse a Postgres.
